        print(f"\n  {c_y}{c_b}Status:{c_reset} {c_r}Disconnected / Not Associated{c_reset}")
        print(f"  {c_b}Interface:{c_reset} {iface}")
        if data["hardware"].get("mac_address"):
            print(f"  {c_b}MAC Address:{c_reset} {data['hardware']['mac_address']}")
        if data["hardware"].get("driver"):
            print(f"  {c_b}Driver:{c_reset} {data['hardware']['driver']}")
