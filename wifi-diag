    rx_disp = spd["rx_bitrate_formatted"] or spd["rx_bitrate"] or "N/A"
    tx_disp = spd["tx_bitrate_formatted"] or spd["tx_bitrate"] or "N/A"
    thru_str = spd["expected_throughput"] or "N/A"
    max_ap = spd["max_ap_rate"] or "N/A"
    print(f"  {c_b}│{c_reset}  RX Bitrate      : {c_g}{c_b}{rx_disp}{c_reset}")
    print(f"  {c_b}│{c_reset}  TX Bitrate      : {c_c}{c_b}{tx_disp}{c_reset}")
    print(f"  {c_b}│{c_reset}  Est. Throughput : {thru_str} | Max AP Rate: {max_ap}")

    # Section 5: IP & Latency
    print(f"  {c_b}{c_c}├── Network & Latency ───────────────────────────────────────────────────────────┤{c_reset}")
    net = data["network"]
    lat = data["latency"]
    ipv4_str = net.get("ipv4") or "None"
    gw_str = net.get("gateway") or "None"
    gw_lat_str = f" ({lat['gateway_ms']:.1f} ms)" if lat.get("gateway_ms") is not None else ""
    net_lat_str = f"{lat['internet_ms']:.1f} ms" if lat.get("internet_ms") is not None else "N/A"
    dns_str = ", ".join(net.get("dns_servers", [])) or "None"
    print(f"  {c_b}│{c_reset}  IPv4 Address    : {ipv4_str}")
    if net.get("ipv6_global"):
        print(f"  {c_b}│{c_reset}  IPv6 Global     : {net['ipv6_global']}")
    print(f"  {c_b}│{c_reset}  Default Gateway : {gw_str}{c_g}{gw_lat_str}{c_reset}")
    print(f"  {c_b}│{c_reset}  DNS Server(s)   : {dns_str}")
    print(f"  {c_b}│{c_reset}  Internet Latency: {net_lat_str} (Cloudflare 1.1.1.1)")

    # Section 6: Health Score & Diagnostic Recommendations
    print(f"  {c_b}{c_c}├── Connection Health & Score ───────────────────────────────────────────────────┤{c_reset}")
    hlth = data["health"]
    sc = hlth["score"]
    sc_col = c_g if sc >= 85 else (c_y if sc >= 65 else c_r)
    print(f"  {c_b}│{c_reset}  Health Score    : {sc_col}{c_b}{sc}/100{c_reset} [{sc_col}{hlth['rating']}{c_reset}]")
    if hlth["tips"]:
        print(f"  {c_b}│{c_reset}  Diagnostic Tips :")
        for tip in hlth["tips"]:
            print(f"  {c_b}│{c_reset}    • {tip}")

    # Section 7: Statistics
    print(f"  {c_b}{c_c}├── Traffic & Reliability ───────────────────────────────────────────────────────┤{c_reset}")
    st = data["stats"]
    uptime_str = format_time(st.get("connected_time_seconds"))
    rx_fmt = format_bytes(st.get("rx_bytes"))
    tx_fmt = format_bytes(st.get("tx_bytes"))
    rx_pkts = f" ({st['rx_packets']:,} pkts)" if st.get("rx_packets") else ""
    tx_pkts = f" ({st['tx_packets']:,} pkts)" if st.get("tx_packets") else ""
    print(f"  {c_b}│{c_reset}  Connected Time  : {uptime_str}")
    print(f"  {c_b}│{c_reset}  Data Received   : {rx_fmt}{rx_pkts}")
    print(f"  {c_b}│{c_reset}  Data Sent       : {tx_fmt}{tx_pkts}")
    retries_str = f"{st.get('tx_retries', 0)} retries"
    failed_str = f"{st.get('tx_failed', 0)} failed"
    drops_str = f"{st.get('rx_drops', 0)} rx drops"
    print(f"  {c_b}│{c_reset}  Error Rates     : {retries_str}, {failed_str}, {drops_str}")
    print(f"  {c_b}{c_c}└────────────────────────────────────────────────────────────────────────────────┘{c_reset}\n")


def print_one_line(data: Dict[str, Any], use_color: bool = True) -> None:
    """Prints a concise one-line summary for status bars / tmux / waybar."""
    if not data["connected"]:
        print(f"{data['interface']}: Disconnected")
        return

    ssid = data["ssid"] or "Unknown"
    band = data["radio"]["band"] or "?"
    ch = data["radio"]["channel"] or "?"
    sig_dbm = data["signal"]["level_dbm"] or 0
    pct = data["signal"]["quality_percent"]
    rx = data["speed"]["rx_bitrate_mbps"]
    tx = data["speed"]["tx_bitrate_mbps"]
    rate_str = f"RX:{rx:.0f}M TX:{tx:.0f}M" if (rx and tx) else ""
    ip = data["network"].get("ipv4", "").split("/")[0]
    gw_lat = data["latency"].get("gateway_ms")
    lat_str = f" ({gw_lat:.1f}ms)" if gw_lat else ""

    parts = [
        f"{ssid}",
        f"{band} Ch{ch}",
        f"{sig_dbm}dBm ({pct}%)",
    ]
    if rate_str:
        parts.append(rate_str)
    if ip:
        parts.append(f"{ip}{lat_str}")

    print(" | ".join(parts))


def print_scan_table(networks: List[Dict[str, Any]], use_color: bool = True) -> None:
    """Renders a clean tabular scan of nearby Wi-Fi networks."""
    c_b = COLOR_BOLD if use_color else ""
    c_c = COLOR_CYAN if use_color else ""
    c_g = COLOR_GREEN if use_color else ""
    c_y = COLOR_YELLOW if use_color else ""
    c_r = COLOR_RED if use_color else ""
    c_dim = COLOR_DIM if use_color else ""
    c_reset = COLOR_RESET if use_color else ""

    print(f"\n{c_b}{c_c}Nearby Wi-Fi Networks ({len(networks)} found):{c_reset}\n")
    header = f"{'USE':<4} {'SSID':<26} {'BSSID':<19} {'CHAN':<5} {'FREQ':<9} {'SIGNAL':<13} {'RATE':<13} {'SECURITY'}"
    print(f"{c_b}{header}{c_reset}")
    print(f"{c_dim}{'─' * len(header)}{c_reset}")

    for net in networks:
        marker = f"{c_g}*{c_reset}" if net["in_use"] else " "
        ssid = net["ssid"]
        if len(ssid) > 25:
            ssid = ssid[:22] + "..."

        sig = net["signal"]
        sig_col = c_g if sig >= 70 else (c_y if sig >= 40 else c_r)
        plain_sig = f"{net['bars']} {sig:>3}%"
        sig_meter = f"{sig_col}{plain_sig:<13}{c_reset}"

        row = (
            f" {marker}  {ssid:<26} {net['bssid']:<19} {net['channel']:<5} "
            f"{net['freq']:<9} {sig_meter} {net['rate']:<13} {net['security']}"
        )
        print(row)
    print()


def run_watch_mode(
    iface: str,
    interval: float,
    use_color: bool = True,
    run_pings: bool = True,
    log_file: Optional[str] = None,
) -> None:
    """Runs a live continuous dashboard update with rolling sparklines and roaming detector."""
    try:
        prev_rx = None
        prev_tx = None
        prev_time = None
        prev_bssid = None

        sig_history = deque(maxlen=28)
        lat_history = deque(maxlen=28)
        roam_events = deque(maxlen=4)

        while True:
            t_now = time.time()
            data = collect_wifi_status(iface, run_pings=run_pings)

            if log_file:
                append_csv_log(log_file, data)

            # Detect roaming events
            cur_bssid = data.get("bssid")
            cur_dbm = data["signal"].get("level_dbm")
            if prev_bssid and cur_bssid and cur_bssid != prev_bssid:
                tm_str = time.strftime("%H:%M:%S")
                roam_events.append(f"[{tm_str}] Roamed: {prev_bssid} → {cur_bssid} ({cur_dbm} dBm)")
            prev_bssid = cur_bssid

            # Update histories
            if cur_dbm is not None:
                sig_history.append(float(cur_dbm))
            cur_lat = data["latency"].get("gateway_ms")
            if cur_lat is not None:
                lat_history.append(float(cur_lat))

            sys.stdout.write("\033[2J\033[H")
            sys.stdout.flush()

            print_dashboard(data, use_color=use_color)

            # Sparklines section
            c_b = COLOR_BOLD if use_color else ""
            c_g = COLOR_GREEN if use_color else ""
            c_c = COLOR_CYAN if use_color else ""
            c_y = COLOR_YELLOW if use_color else ""
            c_r = COLOR_RED if use_color else ""
            c_dim = COLOR_DIM if use_color else ""
            c_reset = COLOR_RESET if use_color else ""

            print(f"  {c_b}Live Real-Time Trends:{c_reset}")
            if sig_history:
                sig_spark = make_sparkline(list(sig_history))
                min_s = int(min(sig_history))
                max_s = int(max(sig_history))
                print(f"    Signal Trend   : [{cur_dbm:>3} dBm] {c_g}{sig_spark}{c_reset}  (Min: {min_s}, Max: {max_s} dBm)")

            if lat_history:
                lat_spark = make_sparkline(list(lat_history))
                min_l = min(lat_history)
                max_l = max(lat_history)
                avg_l = sum(lat_history) / len(lat_history)
                jitter = (max_l - min_l) / 2.0
                print(f"    Gateway Jitter : [{cur_lat:>4.1f} ms] {c_c}{lat_spark}{c_reset}  (Avg: {avg_l:.1f}ms, Jitter: ±{jitter:.1f}ms)")

            # Delta Bandwidth Rate
            cur_rx = data["stats"].get("rx_bytes")
            cur_tx = data["stats"].get("tx_bytes")
            if prev_rx is not None and cur_rx is not None and prev_time is not None:
                dt = max(0.1, t_now - prev_time)
                rx_rate = (cur_rx - prev_rx) / dt
                tx_rate = (cur_tx - prev_tx) / dt
                print(
                    f"    Transfer Rate  : ↓ {c_g}{format_bytes(int(rx_rate))}/s{c_reset}   "
                    f"↑ {c_c}{format_bytes(int(tx_rate))}/s{c_reset}"
                )

            # Roam Event History
            if roam_events:
                print(f"\n  {c_y}{c_b}Recent Roam Events:{c_reset}")
                for evt in roam_events:
                    print(f"    🔄 {c_y}{evt}{c_reset}")

            if log_file:
                print(f"    📁 {c_dim}Site survey logging active -> {log_file}{c_reset}")

            prev_rx = cur_rx
            prev_tx = cur_tx
            prev_time = t_now

            print(f"\n  {c_dim}Live monitor active (Ctrl+C to quit). Refreshing every {interval:.1f}s...{c_reset}")
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\nExiting live monitor.")


def main():
    parser = argparse.ArgumentParser(
        description="Wi-Fi Diagnostic & Status tool - displays detailed SSID, frequency, signal strength, bitrate, throughput, channel advisor, and mesh roaming.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  wifi-diag                     # Full Wi-Fi status dashboard & health score
  wifi-diag -w                  # Live monitor mode with sparklines and roam detector
  wifi-diag -w 2 --log walk.csv # Live monitor with site-survey walk-test CSV logger
  wifi-diag -c                  # Channel congestion & interference advisor
  wifi-diag -m                  # Mesh & multi-AP node inspection for current SSID
  wifi-diag -t                  # Jitter, packet loss, and bufferbloat stress test
  wifi-diag -s                  # Scan nearby Wi-Fi networks
  wifi-diag -j                  # Output full diagnostics in JSON format
  wifi-diag -1                  # One-line summary (for polybar, waybar, tmux)
  wifi-diag -i wlan0            # Target specific wireless interface
  wifi-diag --no-ping           # Skip ping checks for instant output
        """,
    )
    parser.add_argument(
        "-i", "--interface",
        metavar="IFACE",
        help="Specify wireless interface name (default: auto-detect)",
    )
    parser.add_argument(
        "-w", "--watch",
        nargs="?",
        const=1.0,
        type=float,
        metavar="INTERVAL",
        help="Continuously monitor Wi-Fi status with sparklines (default: 1.0s)",
    )
    parser.add_argument(
        "-c", "--channels", "--advisor",
        action="store_true",
        help="Display channel congestion analysis and interference recommendations",
    )
    parser.add_argument(
        "-m", "--mesh", "--roam",
        action="store_true",
        help="Display all mesh/multi-AP nodes broadcasting current SSID and relative signals",
    )
    parser.add_argument(
        "-t", "--test", "--ping-test",
        action="store_true",
        help="Run jitter, packet loss, and stability ping burst test",
    )
    parser.add_argument(
        "--log", "--survey",
        metavar="CSV_FILE",
        help="Log diagnostic records to CSV file (ideal for walk-testing / site survey)",
    )
    parser.add_argument(
        "-s", "--scan",
        action="store_true",
        help="Scan and list nearby Wi-Fi access points",
    )
    parser.add_argument(
        "-j", "--json",
        action="store_true",
        help="Output Wi-Fi status in JSON format",
    )
    parser.add_argument(
        "-1", "--one-line",
        action="store_true",
        help="Output a concise one-line status string",
    )
    parser.add_argument(
        "--no-ping",
        action="store_true",
        help="Skip gateway and internet ping latency checks",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI color codes",
    )
    parser.add_argument(
        "-v", "--version",
        action="version",
        version=f"wifi-diag v{VERSION}",
    )

    args = parser.parse_args()

    use_color = not args.no_color and sys.stdout.isatty() and not args.json

    iface = choose_best_interface(args.interface)
    if not iface:
        sys.stderr.write("Error: No wireless interface detected on this system.\n")
        sys.exit(1)

    # 1. Jitter Stress Test
    if args.test:
        gw = get_ip_info(iface).get("gateway")
        print_jitter_test(gw, use_color=use_color)
        return

    # 2. Channel Congestion Advisor
    if args.channels:
        data = collect_wifi_status(iface, run_pings=False)
        cur_band = data["radio"].get("band")
        cur_chan = data["radio"].get("channel")
        print_channel_advisor(cur_band, cur_chan, use_color=use_color)
        return

    # 3. Mesh & Roaming Inspection
    if args.mesh:
        data = collect_wifi_status(iface, run_pings=False)
        ssid = data.get("ssid")
        bssid = data.get("bssid")
        if not ssid:
            print("Error: Not connected to an SSID to inspect mesh nodes.")
            return
        print_mesh_table(ssid, bssid, use_color=use_color)
        return

    # 4. Scan mode
    if args.scan:
        networks = scan_wifi_networks(iface)
        if args.json:
            print(json.dumps(networks, indent=2))
        else:
            print_scan_table(networks, use_color=use_color)
        return

    # 5. Watch mode
    if args.watch is not None:
        interval = max(0.2, args.watch)
        run_watch_mode(
            iface,
            interval,
            use_color=use_color,
            run_pings=not args.no_ping,
            log_file=args.log,
        )
        return

    # 6. Single Snapshot
    data = collect_wifi_status(iface, run_pings=not args.no_ping)

    if args.log:
        append_csv_log(args.log, data)
        print(f"Recorded snapshot to {args.log}")

    if args.json:
        print(json.dumps(data, indent=2))
    elif args.one_line:
        print_one_line(data, use_color=use_color)
    else:
        print_dashboard(data, use_color=use_color)


if __name__ == "__main__":
    main()
