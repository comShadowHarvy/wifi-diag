# ANSI Colors
COLOR_RESET = "\033[0m"
COLOR_BOLD = "\033[1m"
COLOR_DIM = "\033[2m"
COLOR_CYAN = "\033[36m"
COLOR_GREEN = "\033[32m"
COLOR_YELLOW = "\033[33m"
COLOR_RED = "\033[31m"
COLOR_BLUE = "\033[34m"
COLOR_MAGENTA = "\033[35m"
COLOR_WHITE = "\033[37m"

SPARK_CHARS = " ▂▃▄▅▆▇█"


def run_cmd(cmd: str, timeout: float = 3.0) -> str:
    """Executes a shell command safely and returns its stdout."""
    try:
        proc = subprocess.run(
            cmd,
            shell=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        )
        return proc.stdout.strip()
    except Exception:
        return ""


def format_bytes(n: Optional[int]) -> str:
    """Formats bytes into human readable string."""
    if n is None:
        return "N/A"
    num = float(n)
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if abs(num) < 1024.0:
            return f"{num:.2f} {unit}" if unit in ["MB", "GB", "TB"] else f"{int(num)} {unit}"
        num /= 1024.0
    return f"{num:.2f} PB"


def format_time(seconds: Optional[int]) -> str:
    """Formats duration in seconds to a human readable string."""
    if seconds is None:
        return "N/A"
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes, secs = divmod(rem, 60)
    parts = []
    if days > 0:
        parts.append(f"{days}d")
    if hours > 0 or days > 0:
        parts.append(f"{hours}h")
    if minutes > 0 or hours > 0 or days > 0:
        parts.append(f"{minutes}m")
    parts.append(f"{secs}s")
    return " ".join(parts)


def dbm_to_percent(dbm: Optional[int]) -> int:
    """Calculates signal quality percentage from RSSI dBm."""
    if dbm is None:
        return 0
    if dbm <= -100:
        return 0
    if dbm >= -50:
        return 100
    return int(round(2 * (dbm + 100)))


def signal_quality_rating(dbm: Optional[int]) -> Tuple[str, str]:
    """Returns (label, color_code) for a signal level."""
    if dbm is None:
        return ("Unknown", COLOR_DIM)
    if dbm >= -55:
        return ("Excellent", COLOR_GREEN)
    if dbm >= -66:
        return ("Good", COLOR_CYAN)
    if dbm >= -76:
        return ("Fair", COLOR_YELLOW)
    if dbm >= -86:
        return ("Weak", COLOR_RED)
    return ("Very Poor", COLOR_RED)


def make_meter_bar(percent: int, length: int = 24, use_color: bool = True) -> str:
    """Creates a visual progress/meter bar [██████░░░░]."""
    percent = max(0, min(100, percent))
    filled = int(round((percent / 100.0) * length))
    empty = length - filled

    if not use_color:
        return "[" + ("█" * filled) + ("░" * empty) + "]"

    if percent >= 75:
        c = COLOR_GREEN
    elif percent >= 50:
        c = COLOR_CYAN
    elif percent >= 30:
        c = COLOR_YELLOW
    else:
        c = COLOR_RED

    return f"{c}[{'█' * filled}{COLOR_DIM}{'░' * empty}{COLOR_RESET}{c}]{COLOR_RESET}"


def make_sparkline(values: List[float], min_val: Optional[float] = None, max_val: Optional[float] = None) -> str:
    """Generates an ASCII sparkline representation of rolling numerical values."""
    if not values:
        return ""
    if min_val is None:
        min_val = min(values)
    if max_val is None:
        max_val = max(values)
    span = max_val - min_val
    if span <= 0.001:
        return SPARK_CHARS[4] * len(values)
    res = []
    for v in values:
        clamped = max(min_val, min(max_val, v))
        idx = int(round(((clamped - min_val) / span) * (len(SPARK_CHARS) - 1)))
        res.append(SPARK_CHARS[idx])
    return "".join(res)


def format_bitrate_details(raw: Optional[str]) -> str:
    """Parses raw bitrate string into human-friendly representation with MCS/MIMO."""
    if not raw:
        return "N/A"
    m_mbps = re.search(r"([0-9\.]+)\s*MBit/s", raw)
    mbps = f"{m_mbps.group(1)} Mbit/s" if m_mbps else raw
    tags = []
    m_gen = re.search(r"\b(EHT|HE|VHT|HT)-MCS\s*(\d+)", raw)
    if m_gen:
        tags.append(f"{m_gen.group(1)}-MCS {m_gen.group(2)}")
    else:
        m_mcs = re.search(r"\bMCS\s*(\d+)", raw)
        if m_mcs:
            tags.append(f"MCS {m_mcs.group(1)}")

    m_nss = re.search(r"(?:EHT-|HE-|VHT-|HT-)?NSS\s*(\d+)", raw)
    if m_nss:
        streams = m_nss.group(1)
        tags.append(f"{streams}x{streams} MIMO" if streams in ["2", "3", "4"] else f"{streams} streams")

    m_bw = re.search(r"(\d+)\s*MHz", raw)
    if m_bw:
        tags.append(f"{m_bw.group(1)}MHz")

    if tags:
        tag_str = ", ".join(tags)
        return f"{mbps} ({tag_str})"
    return mbps


def detect_wireless_interfaces() -> List[str]:
    """Detects available wireless interfaces on the system."""
    interfaces = []
    net_path = "/sys/class/net"
    if os.path.exists(net_path):
        for iface in os.listdir(net_path):
            if os.path.exists(os.path.join(net_path, iface, "wireless")) or os.path.exists(
                os.path.join(net_path, iface, "phy80211")
            ):
                interfaces.append(iface)

    if not interfaces:
        iw_out = run_cmd("iw dev")
        for match in re.finditer(r"Interface\s+([a-zA-Z0-9_\-]+)", iw_out):
            interfaces.append(match.group(1))

    return sorted(list(set(interfaces)))


def choose_best_interface(preferred_iface: Optional[str] = None) -> Optional[str]:
    """Selects the best wireless interface (active connected or first available)."""
    interfaces = detect_wireless_interfaces()
    if not interfaces:
        return None
    if preferred_iface:
        return preferred_iface

    for iface in interfaces:
        out = run_cmd(f"iw dev {iface} link")
        if "Connected to" in out:
            return iface

    for iface in interfaces:
        operstate_path = f"/sys/class/net/{iface}/operstate"
        if os.path.exists(operstate_path):
            try:
                with open(operstate_path, "r") as f:
                    if f.read().strip() == "up":
                        return iface
            except Exception:
                pass

    return interfaces[0]


def freq_to_band_and_channel(freq_mhz: Optional[float]) -> Tuple[str, Optional[int]]:
    """Converts frequency in MHz to (Band Name, Channel Number)."""
    if freq_mhz is None:
        return ("Unknown", None)

    f = round(freq_mhz)
    # 2.4 GHz
    if f == 2484:
        return ("2.4 GHz", 14)
    if 2412 <= f <= 2472:
        return ("2.4 GHz", (f - 2412) // 5 + 1)

    # 5 GHz
    if 5160 <= f <= 5885:
        return ("5 GHz", (f - 5000) // 5)

    # 6 GHz (Wi-Fi 6E / 7)
    if 5955 <= f <= 7115:
        return ("6 GHz", (f - 5950) // 5)

    return ("Unknown Band", None)


def determine_wifi_generation(details: str) -> str:
    """Determines Wi-Fi standard / generation from bitrate / protocol strings."""
    d = details.upper()
    if "EHT" in d or "802.11BE" in d:
        return "Wi-Fi 7 (802.11be)"
    if "HE" in d or "802.11AX" in d:
        return "Wi-Fi 6 (802.11ax)"
    if "VHT" in d or "802.11AC" in d:
        return "Wi-Fi 5 (802.11ac)"
    if "HT" in d or "802.11N" in d:
        return "Wi-Fi 4 (802.11n)"
    if "802.11G" in d:
        return "802.11g"
    if "802.11A" in d:
        return "802.11a"
    if "802.11B" in d:
        return "802.11b"
    return "802.11 Legacy"


def get_hardware_info(iface: str) -> Dict[str, Any]:
    """Retrieves driver and hardware model details for the interface."""
    info = {
        "mac_address": None,
        "driver": None,
        "driver_version": None,
        "firmware": None,
        "device_name": None,
        "pci_slot": None,
    }

    mac_path = f"/sys/class/net/{iface}/address"
    if os.path.exists(mac_path):
        try:
            with open(mac_path, "r") as f:
                info["mac_address"] = f.read().strip()
        except Exception:
            pass

    uevent_path = f"/sys/class/net/{iface}/device/uevent"
    pci_slot = None
    if os.path.exists(uevent_path):
        try:
            with open(uevent_path, "r") as f:
                for line in f:
                    if line.startswith("DRIVER="):
                        info["driver"] = line.split("=", 1)[1].strip()
                    elif line.startswith("PCI_SLOT_NAME="):
                        pci_slot = line.split("=", 1)[1].strip()
                        info["pci_slot"] = pci_slot
        except Exception:
            pass

    ethtool_out = run_cmd(f"ethtool -i {iface}")
    for line in ethtool_out.splitlines():
        if line.startswith("driver:"):
            info["driver"] = line.split(":", 1)[1].strip()
        elif line.startswith("version:"):
            info["driver_version"] = line.split(":", 1)[1].strip()
        elif line.startswith("firmware-version:"):
            info["firmware"] = line.split(":", 1)[1].strip()

    if pci_slot:
        lspci_out = run_cmd(f"lspci -s {pci_slot}")
        if ":" in lspci_out:
            clean_name = lspci_out.split(":")[-1].strip()
            if clean_name:
                info["device_name"] = clean_name

    return info


def get_ip_info(iface: str) -> Dict[str, Any]:
    """Gathers IPv4, IPv6, Gateway, and DNS server details."""
    net_info = {
        "ipv4": None,
        "ipv6_global": None,
        "ipv6_link_local": None,
        "gateway": None,
        "dns_servers": [],
    }

    ip_out = run_cmd(f"ip -j addr show {iface}")
    if ip_out.startswith("["):
        try:
            data = json.loads(ip_out)
            if data and "addr_info" in data[0]:
                for addr in data[0]["addr_info"]:
                    if addr.get("family") == "inet" and not net_info["ipv4"]:
                        net_info["ipv4"] = f"{addr.get('local')}/{addr.get('prefixlen')}"
                    elif addr.get("family") == "inet6":
                        if addr.get("scope") == "global" and not net_info["ipv6_global"]:
                            net_info["ipv6_global"] = f"{addr.get('local')}/{addr.get('prefixlen')}"
                        elif addr.get("scope") == "link" and not net_info["ipv6_link_local"]:
                            net_info["ipv6_link_local"] = f"{addr.get('local')}/{addr.get('prefixlen')}"
        except Exception:
            pass

    if not net_info["ipv4"]:
        raw_addr = run_cmd(f"ip addr show {iface}")
        m_v4 = re.search(r"inet\s+([0-9\.]+/\d+)", raw_addr)
        if m_v4:
            net_info["ipv4"] = m_v4.group(1)
        m_v6 = re.search(r"inet6\s+([0-9a-fA-F:]+/\d+)\s+scope\s+global", raw_addr)
        if m_v6:
            net_info["ipv6_global"] = m_v6.group(1)

    route_out = run_cmd(f"ip route show default dev {iface}")
    m_gw = re.search(r"via\s+([0-9\.]+)", route_out)
    if m_gw:
        net_info["gateway"] = m_gw.group(1)

    dns_found = []
    resolve_out = run_cmd(f"resolvectl dns {iface}")
    if "DNS Servers:" in resolve_out:
        dns_servers = resolve_out.split("DNS Servers:", 1)[1].strip().split()
        dns_found.extend(dns_servers)

    if not dns_found:
        nm_out = run_cmd(f"nmcli -t -f IP4.DNS,IP6.DNS dev show {iface}")
        for line in nm_out.splitlines():
            if ":" in line:
                val = line.split(":", 1)[1].strip()
                if val:
                    dns_found.append(val)

    if not dns_found and os.path.exists("/etc/resolv.conf"):
        try:
            with open("/etc/resolv.conf", "r") as f:
                for line in f:
                    if line.startswith("nameserver"):
                        ns = line.split()[1]
                        if ns != "127.0.0.53":
                            dns_found.append(ns)
        except Exception:
            pass

    net_info["dns_servers"] = list(dict.fromkeys(dns_found))
    return net_info


def ping_host(host: str, count: int = 1, timeout: float = 1.0) -> Optional[float]:
    """Pings a host and returns average RTT in ms, or None if failed."""
    if not host:
        return None
    out = run_cmd(f"ping -c {count} -W {int(timeout)} {host}", timeout=timeout + 1.0)
    m = re.search(r"rtt min/avg/max/mdev = [0-9\.]+/([0-9\.]+)/", out)
    if m:
        try:
            return float(m.group(1))
        except ValueError:
            return None
    m2 = re.search(r"time=([0-9\.]+)\s*ms", out)
    if m2:
        try:
            return float(m2.group(1))
        except ValueError:
            return None
    return None


def run_burst_jitter_test(target: str, count: int = 15) -> Dict[str, Any]:
    """Executes a rapid ping burst to measure latency distribution, jitter, and packet loss."""
    cmd = f"ping -c {count} -i 0.2 -W 1 {target}"
    proc = subprocess.run(cmd, shell=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out = proc.stdout

    m_loss = re.search(r"(\d+)% packet loss", out)
    loss = float(m_loss.group(1)) if m_loss else 100.0

    m_rtt = re.search(r"rtt min/avg/max/mdev = ([0-9\.]+)/([0-9\.]+)/([0-9\.]+)/([0-9\.]+)\s*ms", out)
    if m_rtt:
        min_ms = float(m_rtt.group(1))
        avg_ms = float(m_rtt.group(2))
        max_ms = float(m_rtt.group(3))
        jitter_ms = float(m_rtt.group(4))

        if jitter_ms < 3.0 and loss == 0:
            grade = "A+ (Ultra Stable)"
        elif jitter_ms < 8.0 and loss == 0:
            grade = "A (Excellent)"
        elif jitter_ms < 15.0 and loss <= 1.0:
            grade = "B (Good)"
        elif jitter_ms < 30.0 or loss <= 3.0:
            grade = "C (Moderate Jitter)"
        else:
            grade = "D (Poor Stability)"

        return {
            "target": target,
            "success": True,
            "packets_sent": count,
            "loss_pct": loss,
            "min_ms": min_ms,
            "avg_ms": avg_ms,
            "max_ms": max_ms,
            "jitter_ms": jitter_ms,
            "grade": grade,
        }

    return {"target": target, "success": False, "loss_pct": loss, "grade": "F (Failed)"}


def calculate_health_score(data: Dict[str, Any]) -> Tuple[int, str, List[str]]:
    """Calculates an overall Wi-Fi connection health score (0-100) and actionable tips."""
    if not data["connected"]:
        return (0, "Disconnected", ["Interface is not connected to any network."])

    score = 100
    tips = []

    # 1. Signal level (up to 40 pts)
    sig = data["signal"].get("level_dbm")
    if sig is not None:
        if sig >= -55:
            tips.append(f"Signal strength is excellent ({sig} dBm) with minimal attenuation.")
        elif sig >= -66:
            score -= 6
            tips.append(f"Signal strength is good ({sig} dBm).")
        elif sig >= -76:
            score -= 16
            tips.append(f"Signal is fair ({sig} dBm). Moving closer to router could improve throughput.")
        elif sig >= -85:
            score -= 28
            tips.append(f"Signal is weak ({sig} dBm). Expect packet loss and lower bitrate.")
        else:
            score -= 42
            tips.append(f"Signal is critically weak ({sig} dBm). High risk of disconnection.")
    else:
        score -= 20

    # 2. Gateway Latency (up to 25 pts)
    gw_lat = data["latency"].get("gateway_ms")
    if gw_lat is not None:
        if gw_lat < 12.0:
            tips.append(f"Local Wi-Fi response time to router is crisp ({gw_lat:.1f} ms).")
        elif gw_lat < 25.0:
            score -= 5
            tips.append(f"Gateway latency is acceptable ({gw_lat:.1f} ms).")
        elif gw_lat < 50.0:
            score -= 14
            tips.append(f"Gateway latency is elevated ({gw_lat:.1f} ms). Check for interference.")
        else:
            score -= 24
            tips.append(f"High local latency ({gw_lat:.1f} ms) indicates Wi-Fi congestion or bufferbloat.")
    elif data["network"].get("gateway"):
        score -= 10
        tips.append("Gateway ping timed out or ICMP is filtered.")

    # 3. Frequency Band & Channel Width (up to 20 pts)
    band = data["radio"].get("band")
    width = data["radio"].get("channel_width_mhz")
    if band in ["5 GHz", "6 GHz"]:
        if width and width >= 80:
            tips.append(f"High-bandwidth {band} connection ({width} MHz channel width).")
        else:
            score -= 4
    elif band == "2.4 GHz":
        score -= 12
        tips.append("Connected on 2.4 GHz band. 5 GHz / 6 GHz will provide higher throughput if in range.")

    # 4. Error Rates (up to 15 pts)
    failed = data["stats"].get("tx_failed") or 0
    retries = data["stats"].get("tx_retries") or 0
    drops = data["stats"].get("rx_drops") or 0
    if failed > 50 or drops > 1000:
        score -= 8
        tips.append(f"Elevated frame drops ({failed} failed, {drops} rx drops).")

    score = max(0, min(100, score))

    if score >= 90:
        rating = "Optimal Connection"
    elif score >= 75:
        rating = "Good Connection"
    elif score >= 60:
        rating = "Fair Connection"
    else:
        rating = "Poor / Degraded"

    return (score, rating, tips)


def collect_wifi_status(iface: str, run_pings: bool = True) -> Dict[str, Any]:
    """Collects comprehensive Wi-Fi diagnostic data for the given interface."""
    data = {
        "interface": iface,
        "connected": False,
        "ssid": None,
        "bssid": None,
        "mode": "Station",
        "security": None,
        "standard": None,
        "radio": {
            "band": None,
            "channel": None,
            "frequency_mhz": None,
            "channel_width_mhz": None,
            "center_freq_mhz": None,
            "tx_power_dbm": None,
        },
        "signal": {
            "level_dbm": None,
            "average_dbm": None,
            "quality_percent": 0,
            "rating": "Unknown",
            "bars": "",
        },
        "speed": {
            "tx_bitrate": None,
            "tx_bitrate_formatted": None,
            "tx_bitrate_mbps": None,
            "rx_bitrate": None,
            "rx_bitrate_formatted": None,
            "rx_bitrate_mbps": None,
            "expected_throughput": None,
            "max_ap_rate": None,
        },
        "network": {},
        "hardware": {},
        "stats": {
            "connected_time_seconds": None,
            "rx_bytes": None,
            "tx_bytes": None,
            "rx_packets": None,
            "tx_packets": None,
            "tx_retries": None,
            "tx_failed": None,
            "rx_drops": None,
            "beacon_loss": None,
        },
        "latency": {
            "gateway_ms": None,
            "internet_ms": None,
        },
        "health": {
            "score": 0,
            "rating": "Unknown",
            "tips": [],
        },
    }

    data["hardware"] = get_hardware_info(iface)
    data["network"] = get_ip_info(iface)

    ping_threads = []
    if run_pings:
        gw = data["network"].get("gateway")
        if gw:
            def do_gw_ping():
                data["latency"]["gateway_ms"] = ping_host(gw, count=1, timeout=1.0)
            t_gw = threading.Thread(target=do_gw_ping)
            t_gw.start()
            ping_threads.append(t_gw)

        def do_net_ping():
            data["latency"]["internet_ms"] = ping_host("1.1.1.1", count=1, timeout=1.0)
        t_net = threading.Thread(target=do_net_ping)
        t_net.start()
        ping_threads.append(t_net)

    link_out = run_cmd(f"iw dev {iface} link")
    if "Connected to" in link_out:
        data["connected"] = True

        m_bssid = re.search(r"Connected to\s+([0-9a-fA-F:]{17})", link_out)
        if m_bssid:
            data["bssid"] = m_bssid.group(1).lower()

        m_ssid = re.search(r"SSID:\s*(.+)", link_out)
        if m_ssid:
            data["ssid"] = m_ssid.group(1).strip()

        m_freq = re.search(r"freq:\s*([0-9\.]+)", link_out)
        if m_freq:
            try:
                data["radio"]["frequency_mhz"] = float(m_freq.group(1))
            except ValueError:
                pass

        m_sig = re.search(r"signal:\s*(-?\d+)\s*dBm", link_out)
        if m_sig:
            data["signal"]["level_dbm"] = int(m_sig.group(1))

        m_rx_rate = re.search(r"rx bitrate:\s*(.+)", link_out)
        if m_rx_rate:
            data["speed"]["rx_bitrate"] = m_rx_rate.group(1).strip()
            data["speed"]["rx_bitrate_formatted"] = format_bitrate_details(data["speed"]["rx_bitrate"])
            m_mbps = re.search(r"([0-9\.]+)\s*MBit/s", m_rx_rate.group(1))
            if m_mbps:
                data["speed"]["rx_bitrate_mbps"] = float(m_mbps.group(1))

        m_tx_rate = re.search(r"tx bitrate:\s*(.+)", link_out)
        if m_tx_rate:
            data["speed"]["tx_bitrate"] = m_tx_rate.group(1).strip()
            data["speed"]["tx_bitrate_formatted"] = format_bitrate_details(data["speed"]["tx_bitrate"])
            m_mbps = re.search(r"([0-9\.]+)\s*MBit/s", m_tx_rate.group(1))
            if m_mbps:
                data["speed"]["tx_bitrate_mbps"] = float(m_mbps.group(1))

        m_rx_bytes = re.search(r"RX:\s*(\d+)\s*bytes\s*\((\d+)\s*packets\)", link_out)
        if m_rx_bytes:
            data["stats"]["rx_bytes"] = int(m_rx_bytes.group(1))
            data["stats"]["rx_packets"] = int(m_rx_bytes.group(2))

        m_tx_bytes = re.search(r"TX:\s*(\d+)\s*bytes\s*\((\d+)\s*packets\)", link_out)
        if m_tx_bytes:
            data["stats"]["tx_bytes"] = int(m_tx_bytes.group(1))
            data["stats"]["tx_packets"] = int(m_tx_bytes.group(2))

    info_out = run_cmd(f"iw dev {iface} info")
    m_type = re.search(r"type\s+(\w+)", info_out)
    if m_type:
        data["mode"] = m_type.group(1).capitalize()

    m_chan = re.search(
        r"channel\s+(\d+)\s*\(([0-9\.]+)\s*MHz\)(?:,\s*width:\s*(\d+)\s*MHz)?(?:,\s*center1:\s*(\d+)\s*MHz)?",
        info_out,
    )
    if m_chan:
        data["radio"]["channel"] = int(m_chan.group(1))
        if not data["radio"]["frequency_mhz"]:
            data["radio"]["frequency_mhz"] = float(m_chan.group(2))
        if m_chan.group(3):
            data["radio"]["channel_width_mhz"] = int(m_chan.group(3))
        if m_chan.group(4):
            data["radio"]["center_freq_mhz"] = int(m_chan.group(4))

    m_txp = re.search(r"txpower\s+([0-9\.]+)\s*dBm", info_out)
    if m_txp:
        data["radio"]["tx_power_dbm"] = float(m_txp.group(1))

    station_out = run_cmd(f"iw dev {iface} station dump")
    if station_out:
        m_sig_avg = re.search(r"signal avg:\s*(-?\d+)", station_out)
        if m_sig_avg:
            data["signal"]["average_dbm"] = int(m_sig_avg.group(1))

        if data["signal"]["level_dbm"] is None:
            m_sig2 = re.search(r"signal:\s*(-?\d+)", station_out)
            if m_sig2:
                data["signal"]["level_dbm"] = int(m_sig2.group(1))

        m_thru = re.search(r"expected throughput:\s*([0-9\.]+\w+)", station_out)
        if m_thru:
            data["speed"]["expected_throughput"] = m_thru.group(1)

        m_time = re.search(r"connected time:\s*(\d+)\s*seconds", station_out)
        if m_time:
            data["stats"]["connected_time_seconds"] = int(m_time.group(1))

        m_retries = re.search(r"tx retries:\s*(\d+)", station_out)
        if m_retries:
            data["stats"]["tx_retries"] = int(m_retries.group(1))

        m_failed = re.search(r"tx failed:\s*(\d+)", station_out)
        if m_failed:
            data["stats"]["tx_failed"] = int(m_failed.group(1))

        m_drops = re.search(r"rx drop misc:\s*(\d+)", station_out)
        if m_drops:
            data["stats"]["rx_drops"] = int(m_drops.group(1))

        m_beacon = re.search(r"beacon loss:\s*(\d+)", station_out)
        if m_beacon:
            data["stats"]["beacon_loss"] = int(m_beacon.group(1))

        if not data["speed"]["tx_bitrate"]:
            m_st_tx = re.search(r"tx bitrate:\s*(.+)", station_out)
            if m_st_tx:
                data["speed"]["tx_bitrate"] = m_st_tx.group(1).strip()
                data["speed"]["tx_bitrate_formatted"] = format_bitrate_details(data["speed"]["tx_bitrate"])
        if not data["speed"]["rx_bitrate"]:
            m_st_rx = re.search(r"rx bitrate:\s*(.+)", station_out)
            if m_st_rx:
                data["speed"]["rx_bitrate"] = m_st_rx.group(1).strip()
                data["speed"]["rx_bitrate_formatted"] = format_bitrate_details(data["speed"]["rx_bitrate"])

    nm_active = run_cmd(
        "nmcli -t -f active,ssid,bssid,mode,chan,freq,rate,signal,bars,security dev wifi"
    )
    for line in nm_active.splitlines():
        parts = re.split(r"(?<!\\):", line)
        if len(parts) >= 10:
            is_active = parts[0].strip().lower() == "yes"
            bssid_raw = parts[2].replace(r"\:", ":").lower()
            if is_active or (data["bssid"] and bssid_raw == data["bssid"]):
                if not data["connected"]:
                    data["connected"] = True
                if not data["ssid"] and parts[1]:
                    data["ssid"] = parts[1].replace(r"\:", ":")
                if not data["bssid"]:
                    data["bssid"] = bssid_raw
                if not data["security"] and parts[9]:
                    data["security"] = parts[9]
                if data["radio"]["channel"] is None and parts[4].isdigit():
                    data["radio"]["channel"] = int(parts[4])
                if not data["signal"]["bars"] and parts[8]:
                    data["signal"]["bars"] = parts[8]
                if not data["speed"]["max_ap_rate"] and parts[6]:
                    data["speed"]["max_ap_rate"] = parts[6]
                if data["signal"]["level_dbm"] is None and parts[7].isdigit():
                    data["signal"]["level_dbm"] = int(int(parts[7]) / 2 - 100)

    band, ch = freq_to_band_and_channel(data["radio"]["frequency_mhz"])
    data["radio"]["band"] = band
    if data["radio"]["channel"] is None:
        data["radio"]["channel"] = ch

    if data["radio"]["channel_width_mhz"] is None:
        for r_str in [data["speed"]["rx_bitrate"], data["speed"]["tx_bitrate"]]:
            if r_str:
                m_cw = re.search(r"(\d+)\s*MHz", r_str, re.IGNORECASE)
                if m_cw:
                    data["radio"]["channel_width_mhz"] = int(m_cw.group(1))
                    break

    search_str = " ".join(
        filter(
            None,
            [
                data["speed"]["rx_bitrate"],
                data["speed"]["tx_bitrate"],
                data["hardware"].get("device_name"),
            ],
        )
    )
    data["standard"] = determine_wifi_generation(search_str)

    sig_dbm = data["signal"]["level_dbm"]
    data["signal"]["quality_percent"] = dbm_to_percent(sig_dbm)
    rating, _ = signal_quality_rating(sig_dbm)
    data["signal"]["rating"] = rating

    for t in ping_threads:
        t.join(timeout=1.5)

    score, health_rating, tips = calculate_health_score(data)
    data["health"]["score"] = score
    data["health"]["rating"] = health_rating
    data["health"]["tips"] = tips

    return data


def scan_wifi_networks(iface: str) -> List[Dict[str, Any]]:
    """Scans and returns nearby Wi-Fi networks."""
    cmd = "nmcli -t -f in-use,ssid,bssid,mode,chan,freq,rate,signal,bars,security dev wifi list"
    out = run_cmd(cmd, timeout=8.0)
    networks = []

    for line in out.splitlines():
        parts = re.split(r"(?<!\\):", line)
        if len(parts) >= 10:
            in_use = parts[0].strip() == "*"
            ssid = parts[1].replace(r"\:", ":")
            bssid = parts[2].replace(r"\:", ":").lower()
            mode = parts[3]
            chan = parts[4]
            freq = parts[5]
            rate = parts[6]
            signal = int(parts[7]) if parts[7].isdigit() else 0
            bars = parts[8]
            sec = parts[9] if len(parts) > 9 else ""

            # Determine band
            m_f = re.search(r"(\d+)", freq)
            band = "Unknown"
            if m_f:
                f_int = int(m_f.group(1))
                if 2400 <= f_int <= 2500:
                    band = "2.4 GHz"
                elif 5150 <= f_int <= 5895:
                    band = "5 GHz"
                elif 5925 <= f_int <= 7125:
                    band = "6 GHz"

            networks.append(
                {
                    "in_use": in_use,
                    "bssid": bssid,
                    "ssid": ssid if ssid else "<Hidden>",
                    "mode": mode,
                    "band": band,
                    "channel": chan,
                    "freq": freq,
                    "rate": rate,
                    "signal": signal,
                    "bars": bars,
                    "security": sec if sec else "Open",
                }
            )

    networks.sort(key=lambda x: (x["in_use"], x["signal"]), reverse=True)
    return networks


def get_mesh_nodes(ssid: str, current_bssid: Optional[str] = None) -> List[Dict[str, Any]]:
    """Discovers all AP nodes belonging to the current SSID and compares signal levels."""
    all_networks = scan_wifi_networks("wlan0")
    matching = [n for n in all_networks if n["ssid"] == ssid]

    curr_sig = 0
    if current_bssid:
        for n in matching:
            if n["bssid"] == current_bssid:
                curr_sig = n["signal"]
                break

    for n in matching:
        delta = n["signal"] - curr_sig
        n["delta_pct"] = delta
        n["is_current"] = (current_bssid is not None and n["bssid"] == current_bssid)

    matching.sort(key=lambda x: (x["is_current"], x["signal"]), reverse=True)
    return matching


def print_mesh_table(ssid: str, current_bssid: Optional[str], use_color: bool = True) -> None:
    """Renders a clean comparison table of mesh / multi-AP nodes."""
    c_b = COLOR_BOLD if use_color else ""
    c_c = COLOR_CYAN if use_color else ""
    c_g = COLOR_GREEN if use_color else ""
    c_y = COLOR_YELLOW if use_color else ""
    c_r = COLOR_RED if use_color else ""
    c_dim = COLOR_DIM if use_color else ""
    c_reset = COLOR_RESET if use_color else ""

    nodes = get_mesh_nodes(ssid, current_bssid)
    print(f"\n{c_b}{c_c}Mesh & Multi-AP Nodes for SSID '{ssid}' ({len(nodes)} nodes detected):{c_reset}\n")

    if not nodes:
        print(f"  {c_dim}No access points found broadcasting SSID '{ssid}'.{c_reset}\n")
        return

    header = f"{'STATE':<13} {'BSSID':<19} {'BAND':<9} {'CHAN':<6} {'FREQ':<10} {'SIGNAL':<13} {'DELTA':<10} {'NOTES'}"
    print(f"{c_b}{header}{c_reset}")
    print(f"{c_dim}{'─' * len(header)}{c_reset}")

    for n in nodes:
        if n["is_current"]:
            plain_state = "[CONNECTED]"
            state_str = f"{c_g}{plain_state:<13}{c_reset}"
            plain_delta = "Active"
            delta_str = f"{plain_delta:<10}"
            notes = f"{c_g}Current Connected Node{c_reset}"
        else:
            plain_state = "[AVAILABLE]"
            state_str = f"{c_dim}{plain_state:<13}{c_reset}"
            d = n["delta_pct"]
            if d > 0:
                plain_delta = f"+{d}%"
                delta_str = f"{c_g}{plain_delta:<10}{c_reset}"
                notes = f"{c_g}Stronger Node Available!{c_reset}" if d >= 10 else "Nearby node"
            elif d < 0:
                plain_delta = f"{d}%"
                delta_str = f"{c_dim}{plain_delta:<10}{c_reset}"
                notes = f"{c_dim}Weaker node{c_reset}"
            else:
                plain_delta = "Equal"
                delta_str = f"{plain_delta:<10}"
                notes = "Equal signal"

        sig = n["signal"]
        sig_col = c_g if sig >= 70 else (c_y if sig >= 40 else c_r)
        plain_sig = f"{n['bars']} {sig:>3}%"
        sig_meter = f"{sig_col}{plain_sig:<13}{c_reset}"

        print(
            f"{state_str} {n['bssid']:<19} {n['band']:<9} {n['channel']:<6} "
            f"{n['freq']:<10} {sig_meter} {delta_str} {notes}"
        )
    print()


def print_channel_advisor(current_band: Optional[str] = None, current_chan: Optional[int] = None, use_color: bool = True) -> None:
    """Analyzes RF channel congestion across bands and suggests optimal channels."""
    c_b = COLOR_BOLD if use_color else ""
    c_c = COLOR_CYAN if use_color else ""
    c_g = COLOR_GREEN if use_color else ""
    c_y = COLOR_YELLOW if use_color else ""
    c_r = COLOR_RED if use_color else ""
    c_dim = COLOR_DIM if use_color else ""
    c_reset = COLOR_RESET if use_color else ""

    networks = scan_wifi_networks("wlan0")
    band_channels: Dict[str, Dict[int, List[Dict[str, Any]]]] = {
        "2.4 GHz": defaultdict(list),
        "5 GHz": defaultdict(list),
        "6 GHz": defaultdict(list),
    }

    for n in networks:
        band = n.get("band")
        ch_str = str(n.get("channel", ""))
        if band in band_channels and ch_str.isdigit():
            band_channels[band][int(ch_str)].append(n)

    print(f"\n{c_b}{c_c}╔══════════════════════════════════════════════════════════════════════════════════╗{c_reset}")
    print(f"{c_b}{c_c}║{c_WHITE if 'c_WHITE' in locals() else COLOR_WHITE} Wi-Fi Channel Congestion & Interference Advisor                                ║{c_reset}")
    print(f"{c_b}{c_c}╚══════════════════════════════════════════════════════════════════════════════════╝{c_reset}\n")

    # Analyze 2.4 GHz (Standard non-overlapping: 1, 6, 11)
    print(f"  {c_b}2.4 GHz Band Distribution:{c_reset}")
    ch_24 = band_channels["2.4 GHz"]
    cleanest_24 = None
    min_count_24 = 9999

    for ch in sorted(ch_24.keys()):
        count = len(ch_24[ch])
        is_cur = (current_band == "2.4 GHz" and current_chan == ch)
        cur_mark = f"{c_g} [CURRENT]{c_reset}" if is_cur else ""

        # Rating
        if count <= 2:
            status = f"{c_g}Clean / Low Traffic{c_reset}"
        elif count <= 5:
            status = f"{c_y}Moderate{c_reset}"
        else:
            status = f"{c_r}Crowded ({count} APs){c_reset}"

        bar = "█" * min(15, count)
        print(f"    Channel {ch:>2} : {bar:<15} {status}{cur_mark}")

        if ch in [1, 6, 11] and count < min_count_24:
            min_count_24 = count
            cleanest_24 = ch

    if cleanest_24:
        print(f"    {c_c}↳ Recommendation:{c_reset} Best non-overlapping 2.4 GHz channel: {c_b}Channel {cleanest_24}{c_reset}\n")
    else:
        print(f"    {c_c}↳ Recommendation:{c_reset} Standard non-overlapping channels: {c_b}1, 6, 11{c_reset}\n")

    # Analyze 5 GHz (UNII-1: 36-48, UNII-2: 52-64, UNII-2e: 100-144, UNII-3: 149-165)
    print(f"  {c_b}5 GHz Band Distribution:{c_reset}")
    ch_5 = band_channels["5 GHz"]
    clean_candidates_5 = []

    for ch in sorted(ch_5.keys()):
        count = len(ch_5[ch])
        is_cur = (current_band == "5 GHz" and current_chan == ch)
        cur_mark = f"{c_g} [CURRENT]{c_reset}" if is_cur else ""

        if count <= 2:
            status = f"{c_g}Clean ({count} APs){c_reset}"
            clean_candidates_5.append(ch)
        elif count <= 6:
            status = f"{c_y}Moderate ({count} APs){c_reset}"
        else:
            status = f"{c_r}Crowded ({count} APs){c_reset}"

        bar = "█" * min(20, count)
        print(f"    Channel {ch:>3} : {bar:<20} {status}{cur_mark}")

    rec_ch_5 = clean_candidates_5[0] if clean_candidates_5 else (36 if 36 not in ch_5 else 44)
    print(f"    {c_c}↳ Recommendation:{c_reset} Consider UNII-1/2 Channels (e.g. {c_b}Channel {rec_ch_5}{c_reset}) for less interference.\n")


def print_jitter_test(gateway: Optional[str], use_color: bool = True) -> None:
    """Runs a rapid ping burst to measure connection jitter, packet loss, and bufferbloat."""
    c_b = COLOR_BOLD if use_color else ""
    c_c = COLOR_CYAN if use_color else ""
    c_g = COLOR_GREEN if use_color else ""
    c_y = COLOR_YELLOW if use_color else ""
    c_r = COLOR_RED if use_color else ""
    c_dim = COLOR_DIM if use_color else ""
    c_reset = COLOR_RESET if use_color else ""

    print(f"\n{c_b}{c_c}Running Wi-Fi Jitter & Connection Stability Test (15 packets)...{c_reset}")

    targets = []
    if gateway:
        targets.append(("Local Gateway (Router)", gateway))
    targets.append(("Internet DNS (Cloudflare)", "1.1.1.1"))

    print(f"\n{'TARGET':<28} {'MIN':<9} {'AVG':<9} {'MAX':<9} {'JITTER (mdev)':<15} {'LOSS':<8} {'GRADE'}")
    print(f"{c_dim}{'─' * 94}{c_reset}")

    for label, ip in targets:
        res = run_burst_jitter_test(ip, count=10)

        if res["success"]:
            loss_col = c_g if res["loss_pct"] == 0 else (c_y if res["loss_pct"] <= 2 else c_r)
            jit_col = c_g if res["jitter_ms"] < 5 else (c_y if res["jitter_ms"] < 15 else c_r)
            loss_str = f"{loss_col}{res['loss_pct']:.0f}%{c_reset}"
            jit_str = f"{jit_col}±{res['jitter_ms']:.2f} ms{c_reset}"
            row = (
                f"{label:<28} {res['min_ms']:>6.1f} ms {res['avg_ms']:>6.1f} ms "
                f"{res['max_ms']:>6.1f} ms {jit_str:<24} {loss_str:<17} {c_b}{res['grade']}{c_reset}"
            )
            print(row)
        else:
            print(f"{label:<28} {c_r}Ping failed or host unreachable (100% loss){c_reset}")
    print()


