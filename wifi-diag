    print(f"  {c_b}│{c_reset}  Security        : {sec_str}")
    print(f"  {c_b}│{c_reset}  Standard        : {c_g}{data['standard']}{c_reset}")
    print(f"  {c_b}│{c_reset}  Mode            : {data['mode']}")

    # Section 2: Frequency & Radio
    print(f"  {c_b}{c_c}├── Frequency & Radio ───────────────────────────────────────────────────────────┤{c_reset}")
